# Copy this file to .env and fill in the values from your Supabase project:
# Supabase dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional. Where password-reset and confirmation emails should send people.
# Leave it unset to use whatever address the request was made from; set it when
# a reset requested on localhost still has to open on the deployed site.
# Must also be listed in Supabase → Authentication → URL Configuration.
# VITE_SITE_URL=https://your-username.github.io/your-repo/
